# Telegram
TG_TOKEN=your_telegram_bot_token

# OpenRouter (Gemini 3 Flash с thinking medium)
OPENROUTER_API_KEY=your_openrouter_api_key
# Опционально: модель (по умолчанию google/gemini-3-flash-preview)
# OPENROUTER_MODEL=google/gemini-3-flash-preview
# Для теста точности: Gemini 3.1 Pro (дороже, медленнее, но точнее)
# OPENROUTER_MODEL=google/gemini-3.1-pro-preview
# DAY_SUMMARY_MODEL=google/gemini-3.1-pro-preview

# Supabase (используйте service role key для доступа из бота)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# Опционально
LOG_LEVEL=INFO
# Тайм-аут и retry для OpenRouter
# OPENROUTER_TIMEOUT_SEC=120
# OPENROUTER_MAX_RETRIES=3
# Structured output (json_schema) для более стабильного JSON
# OPENROUTER_USE_STRUCTURED_OUTPUT=true
# Переводить top-хуки в AI day summary на русский (в скобках)
DAY_SUMMARY_TRANSLATE_TOP_HOOKS=true
# Каждые N запросов логируется quality snapshot AI (успешность/ошибки)
AI_QUALITY_LOG_EVERY_N=25
# Ограничение параллельной обработки видео (защита от перегрузки API/памяти)
# MAX_CONCURRENT_ANALYSIS=5
# Жесткий тайм-аут скачивания одного файла из Telegram (секунды)
# TG_FILE_DOWNLOAD_TIMEOUT_SEC=20
# Telegram user_id администратора (получит уведомление о новых пользователях)
# ADMIN_USER_ID=123456789
# Для webhook на Railway (если не используете long polling)
# WEBHOOK_URL=https://your-app.railway.app
# WEBHOOK_PATH=/webhook

# Google Sheets (Service Account для экспорта аналитики хуков)
# GOOGLE_SHEET_CREDENTIALS_PATH=./credentials-gsheet.json
# GOOGLE_SHEET_ID=your_spreadsheet_id
# Название листа, если не "Hook Analytics" (например Hooks CRM)
# GOOGLE_SHEET_WORKSHEET_NAME=Hooks CRM
# Источник форматов для Content Performance
# CONTENT_FORMATS_SHEET_ID=1uvhjgRWQhgrRC4bbhsrrlZHOwQ4m9IXd-RwmrW8pGYo
# CONTENT_FORMATS_WORKSHEET_GID=1584230146
# CONTENT_FORMATS_SOURCE_NAME=ТЗ Otty
# CONTENT_PERFORMANCE_TIMEZONE=Europe/Minsk

# Ежедневный отчёт day_stats по расписанию
# REPORT_SCHEDULE_ENABLED=false
# REPORT_CHAT_ID=-1002980367669
# REPORT_TOPIC_ID=5047
# REPORT_TIMEZONE=Europe/Minsk
# REPORT_HOUR=15
# REPORT_MINUTE=0

# Public social scraper and its daily UTC schedule
# SCRAPECREATORS_API_KEY=
# SCRAPECREATORS_TIMEOUT_SEC=60
# SCRAPECREATORS_MAX_RETRIES=3
# SCRAPECREATORS_RETRY_BACKOFF_SEC=1
# SOCIAL_SCRAPE_ENABLED=true
# Авто-сообщение по итогам social scrape в Telegram-чат выключено по умолчанию
# SOCIAL_SCRAPE_SEND_TO_TELEGRAM=false
# SOCIAL_SCRAPE_RETRY_FAILED_ACCOUNTS=true
# SOCIAL_SCRAPE_MIN_BASELINE_VIDEOS=20
# SOCIAL_SCRAPE_BASELINE_LOOKBACK_DAYS=7
# SOCIAL_SCRAPE_MIN_SNAPSHOT_RATIO=0.5
# Утренний сбор следующего дня: 09:00 UTC+3 = 06:00 UTC
# SOCIAL_SCRAPE_HOUR_UTC=6
# SOCIAL_SCRAPE_MINUTE_UTC=0
# SOCIAL_SCRAPE_TIMEZONE=Europe/Minsk
# SOCIAL_SCRAPE_MAX_PAGES=20
# Строка в Marketing Daily будет записана за предыдущий день
# SOCIAL_SCRAPE_METRIC_LAG_DAYS=1
# Защита при смене расписания: если интервал между снапшотами слишком короткий/длинный,
# daily metric пропускается и текущий снапшот становится новым baseline.
# SOCIAL_SCRAPE_INTERVAL_MIN_HOURS=18
# SOCIAL_SCRAPE_INTERVAL_MAX_HOURS=30
# Комментарии: старт после 50K, пять дней, только top-level, максимум 2000
# CONTENT_COMMENT_VIEW_THRESHOLD=50000
# CONTENT_COMMENT_TRACKING_DAYS=5
# CONTENT_COMMENT_MAX_ANALYZED=2000
# CONTENT_COMMENT_AI_BATCH_SIZE=200

# App Store Connect API (ежедневное обновление App Store Funnel в 09:00 Europe/Minsk)
# APPSTORE_ISSUER_ID=
# APPSTORE_KEY_ID=
# Локально можно дать путь до .p8 файла:
# APPSTORE_PRIVATE_KEY_PATH=~/Downloads/AuthKey_XXXXXXXXXX.p8
# APPSTORE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPSTORE_BUNDLE_ID=com.example.app
# APPSTORE_ANALYTICS_ENABLED=true
# APPSTORE_ANALYTICS_START_DATE=2026-07-16
# APPSTORE_ANALYTICS_HOUR=9
# APPSTORE_ANALYTICS_MINUTE=0
# APPSTORE_ANALYTICS_TIMEZONE=Europe/Minsk
# Adapty Export Analytics API (trial and paid cohort metrics)
# ADAPTY_SECRET_KEY=secret_live_...

# Google Play reports export (для будущего автосбора Marketing Funnels)
# GOOGLE_PLAY_PACKAGE_NAME=com.example.app
# GOOGLE_PLAY_REPORTS_BUCKET=
# GOOGLE_PLAY_REPORTS_PREFIX=
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=./google-play-reports.json
