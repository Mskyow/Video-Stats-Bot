# Telegram
TG_TOKEN=your_telegram_bot_token

# OpenRouter (Gemini 3 Flash с thinking medium)
OPENROUTER_API_KEY=your_openrouter_api_key
# Опционально: модель (по умолчанию google/gemini-3-flash-preview)
# OPENROUTER_MODEL=google/gemini-3-flash-preview

# Supabase (используйте service role key для доступа из бота)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# Опционально
LOG_LEVEL=INFO
# Тайм-аут и retry для OpenRouter
# OPENROUTER_TIMEOUT_SEC=120
# OPENROUTER_MAX_RETRIES=3
# Structured output (json_schema) для более стабильного JSON
# OPENROUTER_USE_STRUCTURED_OUTPUT=true
# Переводить top-хуки в AI day summary на русский (в скобках)
DAY_SUMMARY_TRANSLATE_TOP_HOOKS=true
# Каждые N запросов логируется quality snapshot AI (успешность/ошибки)
AI_QUALITY_LOG_EVERY_N=25
# Ограничение параллельной обработки видео (защита от перегрузки API/памяти)
# MAX_CONCURRENT_ANALYSIS=5
# Жесткий тайм-аут скачивания одного файла из Telegram (секунды)
# TG_FILE_DOWNLOAD_TIMEOUT_SEC=20
# Telegram user_id администратора (получит уведомление о новых пользователях)
# ADMIN_USER_ID=123456789
# Для webhook на Railway (если не используете long polling)
# WEBHOOK_URL=https://your-app.railway.app
# WEBHOOK_PATH=/webhook

# Google Sheets (Service Account для экспорта аналитики хуков)
# GOOGLE_SHEET_CREDENTIALS_PATH=./credentials-gsheet.json
# GOOGLE_SHEET_ID=your_spreadsheet_id
# Название листа, если не "Hook Analytics" (например Hooks CRM)
# GOOGLE_SHEET_WORKSHEET_NAME=Hooks CRM

# Ежедневный отчёт day_stats по расписанию
# REPORT_CHAT_ID=-1002980367669
# REPORT_TOPIC_ID=5047
# REPORT_TIMEZONE=Europe/Minsk
# REPORT_HOUR=15
# REPORT_MINUTE=0
