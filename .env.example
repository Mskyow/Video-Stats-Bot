# Telegram
TG_TOKEN=your_telegram_bot_token

# Google Gemini (новый SDK: google.genai)
GEMINI_API_KEY=your_gemini_api_key
# Модель: gemini-2.5-flash, gemini-2.0-flash, gemini-3-flash-preview (не gemini-3.0-flash — такой нет)
GEMINI_MODEL=gemini-2.5-flash

# Supabase (используйте service role key для доступа из бота)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# Опционально
LOG_LEVEL=INFO
# Разрешить всех пользователей без whitelist (для теста: 1 или true)
# ALLOW_ALL_USERS=1
# Telegram user_id администратора (получит уведомление о новых пользователях)
# ADMIN_USER_ID=123456789
# Для webhook на Railway (если не используете long polling)
# WEBHOOK_URL=https://your-app.railway.app
# WEBHOOK_PATH=/webhook
