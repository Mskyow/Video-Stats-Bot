# Telegram
TG_TOKEN=your_telegram_bot_token

# Google Gemini (Flash Thinking)
GEMINI_API_KEY=your_gemini_api_key
# Модель (например gemini-2.0-flash-thinking-exp или новее)
GEMINI_MODEL=gemini-3.0-flash-thinking-exp

# Supabase (используйте service role key для доступа из бота)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# Опционально
LOG_LEVEL=INFO
# Разрешить всех пользователей без whitelist (для теста: 1 или true)
# ALLOW_ALL_USERS=1
# Telegram user_id администратора (получит уведомление о новых пользователях)
# ADMIN_USER_ID=123456789
# Для webhook на Railway (если не используете long polling)
# WEBHOOK_URL=https://your-app.railway.app
# WEBHOOK_PATH=/webhook
